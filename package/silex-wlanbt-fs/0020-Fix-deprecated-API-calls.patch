@@ -35,7 +35,12 @@
 #include "vos_cnss.h"
 #include <adf_os_types.h>
 
-typedef struct tasklet_struct  __adf_os_bh_t;
+typedef struct __adf_os_bh {
+    struct tasklet_struct tasklet;
+    adf_os_defer_fn_t func;
+    void *arg;
+} __adf_os_bh_t;
+
 typedef struct workqueue_struct __adf_os_workqueue_t;
 
 /**
@@ -56,8 +61,6 @@ typedef struct {
 extern void __adf_os_defer_func(struct work_struct *work);
 extern void __adf_os_defer_delayed_func(struct work_struct *work);
 
-typedef void (*__adf_os_bh_fn_t)(unsigned long arg);
-
 static inline a_status_t
 __adf_os_init_work(adf_os_handle_t    hdl,
                    __adf_os_work_t      *work,
@@ -109,12 +112,22 @@ static inline void __adf_os_destroy_workqueue(adf_os_handle_t hdl, __adf_os_work
     destroy_workqueue(wqueue);
 }
 
-static inline  a_status_t __adf_os_init_bh(adf_os_handle_t  hdl,
-                                     struct tasklet_struct *bh,
-                                     adf_os_defer_fn_t  func,
-                                     void               *arg)
+static void __adf_tasklet_trampoline(struct tasklet_struct *t)
 {
-     tasklet_init(bh, (__adf_os_bh_fn_t)func, (unsigned long)arg);
+	__adf_os_bh_t *bh = from_tasklet(bh, t, tasklet);
+
+	if (bh->func)
+		bh->func(bh->arg);
+}
+
+static inline  a_status_t __adf_os_init_bh(adf_os_handle_t hdl, __adf_os_bh_t *bh,
+                                           adf_os_defer_fn_t func,
+                                           void *arg)
+{
+    bh->func =func;
+	bh->arg = arg;
+
+	tasklet_setup(&bh->tasklet, __adf_tasklet_trampoline);
 
      return A_STATUS_OK;
 }
@@ -127,9 +140,9 @@ __adf_os_sched_work(adf_os_handle_t hdl, __adf_os_work_t  * work)
 }
 
 static inline a_status_t  __adf_os_sched_bh(adf_os_handle_t hdl,
-                                     struct tasklet_struct * bh)
+                                     __adf_os_bh_t *bh)
 {
-    tasklet_schedule(bh);
+    tasklet_schedule(&bh->tasklet);
 
     return A_STATUS_OK;
 }
@@ -143,9 +156,9 @@ __adf_os_disable_work(adf_os_handle_t hdl, __adf_os_work_t  * work)
     return A_STATUS_OK;
 }
 static inline a_status_t
-__adf_os_disable_bh(adf_os_handle_t hdl, struct tasklet_struct *bh)
+__adf_os_disable_bh(adf_os_handle_t hdl, __adf_os_bh_t *bh)
 {
-    tasklet_kill(bh);
+    tasklet_kill(&bh->tasklet);
 
     return A_STATUS_OK;
 }
